# CampusKit Private — optional billing configuration
#
# Checkout stays in local-activation mode until a public key is present.
# Add one of the keys below, restart the dev server, and the upgrade flow
# will hand off to the provider instead of activating locally.
#
# Paystack (NGN + USD). Public key only — never put a secret key in the frontend.
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
#
# Stripe (USD). Publishable key only.
# VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
#
# Currency used for displayed prices: USD or NGN.
# VITE_BILLING_CURRENCY=USD
